// ==========================================================================
// Scale Up Nano — Firebase Storage security rules
//
// Paste this into: Firebase Console → Storage → Rules tab → Publish
//
// Logic: anyone can view uploaded photos (member photos, memory photos),
// but only a signed-in admin can upload or delete them.
// ==========================================================================

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
